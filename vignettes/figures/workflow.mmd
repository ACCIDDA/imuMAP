graph TD
    subgraph Inputs["1. Model & Geospatial Inputs"]
        GAP["imuGAP Estimates<br/>(predict_sim / observations_sim)"]
        SCH["School Points<br/>(nc_schools)"]
        CBG["Census Block Groups<br/>(nc_cbgs)"]
        DEM["CBG Demographics<br/>(nc_demographics)"]
    end

    subgraph Preparation["2. Canonicalization"]
        CAN_SP["canonicalize_spatial()<br/>Harmonize CRS & Validate Schemas"]
        CAN_DEM["canonicalize_demographics()<br/>Validate Populations"]
        SCH --> CAN_SP
        CBG --> CAN_SP
        DEM --> CAN_DEM
    end

    subgraph Matrices["3. Intermediate Structures"]
        DIST["calc_distance_matrix()<br/>Pairwise Distance Matrix"]
        TIER["allocation_tier()<br/>Public (Bounded) & Private (Residual)"]
        WTS["calc_iterative_weights()<br/>Multi-Tier Residual Allocation"]

        CAN_SP --> DIST
        DIST --> WTS
        CAN_DEM --> WTS
        TIER --> WTS
    end

    subgraph Projection["4. Allocation & Mapping"]
        ALLOC["allocate()<br/>Project Coverage & Posterior Draws"]
        MAP["Geospatial Choropleth<br/>CBG Coverage Surface"]

        GAP --> ALLOC
        WTS --> ALLOC
        ALLOC --> MAP
        CBG --> MAP
    end
